
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PapelUsuario {
  ADMINISTRADOR
  OPERADOR_CADASTRO
  GESTOR_ALMOXARIFADO
  AUDITOR
}

enum TipoEquipamento {
  COMPUTADOR_MESA
  NOTEBOOK
  MONITOR
  IMPRESSORA
  SERVIDOR
  SCANNER
  BATERIA
  CAIXA_ESTABILIZADOR
  FONTE_ALIMENTACAO
}

enum EstadoFisico {
  NOVO
  BOM_ESTADO
  USADO_LEVE
  USADO_MODERADO
  DANIFICADO_LEVE
  DANIFICADO_GRAVE
  IRRECUPERAVEL
}

enum StatusEquipamento {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  ENCAMINHADO
  DESMONTE
  RECICLAGEM
  DESCARTE
}

enum StatusLote {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  ENCAMINHADO
  FINALIZADO
}

model Usuario {
  id             String         @id @default(cuid())
  versao          Int            @default(1)
  usuario         String         @unique
  senhaHash       String
  papel           PapelUsuario   @default(OPERADOR_CADASTRO)
  ultimoAcesso    DateTime?
  ativo           Boolean        @default(true)
  protegido       Boolean        @default(false)
  criadoEm        DateTime       @default(now())
  movimentacoes   Movimentacao[]
  sessoes         Sessao[]
}

model Sessao {
  id        String   @id @default(cuid())
  usuarioId String
  ultimoUso DateTime @default(now())
  criadoEm  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([ultimoUso])
}

model Organizacao {
  id                  String   @id @default(cuid())
  versao              Int      @default(1)
  razaoSocial         String
  cnpj                String   @unique
  inscricaoEstadual   String
  enderecoCompleto    String   @db.Text
  telefone            String
  email               String
  dataCadastro        DateTime @default(now())
  ativo               Boolean  @default(true)

  contratos Contrato[]
  lotes     Lote[]
}

model Contrato {
  id                String   @id @default(cuid())
  versao            Int      @default(1)
  organizacaoId     String
  dataInicio        DateTime
  dataFim           DateTime
  descricao         String   @db.Text
  valorMensal       Decimal  @db.Decimal(12, 2)
  coletaAutomatica  Boolean  @default(false)
  ativo             Boolean  @default(true)

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)

  @@index([organizacaoId])
}

model Lote {
  id              String     @id @default(cuid())
  versao          Int        @default(1)
  dataEntrada     DateTime
  organizacaoId   String
  notaFiscal      String
  transportadora  String
  status          StatusLote @default(RECEBIDO)
  ativo           Boolean    @default(true)
  observacoes     String     @db.Text

  organizacao  Organizacao  @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  equipamentos Equipamento[]

  @@index([organizacaoId])
}

model Equipamento {
  id                   String            @id @default(cuid())
  versao               Int               @default(1)
  loteId               String
  codigoBarrasInterno  String            @unique
  tipo                 TipoEquipamento
  marca                String
  modelo               String
  anoFabricacao        Int
  estadoFisico         EstadoFisico
  ativo                Boolean           @default(true)
  dataEntrada          DateTime
  local                String
  peso                 Float
  status               StatusEquipamento @default(RECEBIDO)

  lote          Lote          @relation(fields: [loteId], references: [id], onDelete: Cascade)
  movimentacoes Movimentacao[]
}

model Movimentacao {
  id             String            @id @default(cuid())
  versao         Int               @default(1)
  equipamentoId  String
  statusAnterior StatusEquipamento
  novoStatus     StatusEquipamento
  data           DateTime          @default(now())
  usuarioId      String
  justificativa  String            @db.Text

  equipamento Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  autor       Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([equipamentoId, data])
  @@index([usuarioId])
}

model Auditoria {
  id         String   @id @default(cuid())
  versao     Int      @default(1)
  usuario    String
  acao       String
  entidade   String
  entidadeId String
  detalhes   String   @db.Text
  data       DateTime @default(now())

  @@index([data])
  @@index([entidade, entidadeId])
}

model Configuracao {
  id                    String   @id @default("GLOBAL")
  versao                Int      @default(1)
  aliquotaImposto       Decimal  @default(0) @db.Decimal(5, 2)
  coeficienteDepreciacao Decimal @default(0) @db.Decimal(5, 2)
  atualizadoPor         String?
  atualizadoEm          DateTime @updatedAt
}
