# MySQL local (crie o banco greencode antes de executar as migrações)
DATABASE_URL="mysql://root:SUA_SENHA_MYSQL@localhost:3306/greencode"
JWT_SECRET="substitua-por-uma-chave-secreta-com-pelo-menos-32-caracteres"
PORT=3000
ADMIN_USER="admin"
ADMIN_PASSWORD="defina-uma-senha-forte-com-10-ou-mais-caracteres"
CORS_ORIGIN="http://localhost:5173,http://localhost:3001"

# Configure somente quando a API estiver atrás de proxy reverso confiável.
# false = acesso direto; 1 = um proxy confiável; também aceita quantidade de saltos ou lista de IP/CIDR confiáveis.
# Nunca use 1/true se a API estiver exposta diretamente ou se o proxy não sobrescrever X-Forwarded-For.
TRUST_PROXY=false
